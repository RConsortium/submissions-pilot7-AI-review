{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/adrg-json/0.1/adrg.schema.json",
  "title": "ADRG-JSON",
  "description": "Machine-readable Analysis Data Reviewer's Guide. Starts at the shell stage (SAP and table shells, before any data) and is completed as metadata, programs and results appear. Facts held elsewhere (define.xml, Dataset-JSON, programs, receipts) are referenced by ID or generated into a hash-stamped snapshot; only judgement is authored. The PDF ADRG is rendered from this file.",
  "type": "object",
  "required": ["adrgJSONVersion", "study", "lifecycle", "analyses", "displays"],
  "additionalProperties": false,
  "properties": {
    "adrgJSONVersion": {"const": "0.1.0"},
    "study": {
      "type": "object",
      "required": ["studyId", "title"],
      "additionalProperties": false,
      "properties": {
        "studyId": {"type": "string"},
        "protocolNumber": {"type": "string"},
        "title": {"type": "string"},
        "aliases": {"type": "array", "items": {
          "type": "object", "required": ["value", "where"], "additionalProperties": false,
          "properties": {"value": {"type": "string"}, "where": {"type": "string"}, "note": {"type": "string"}}}}
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["stage", "history"],
      "additionalProperties": false,
      "properties": {
        "stage": {"$ref": "#/$defs/Stage"},
        "history": {"type": "array", "items": {
          "type": "object", "required": ["stage", "date", "by"], "additionalProperties": false,
          "properties": {"stage": {"$ref": "#/$defs/Stage"}, "date": {"type": "string"}, "by": {"type": "string"},
                         "commit": {"type": ["string", "null"]}, "note": {"type": "string"}}}},
        "openItems": {"type": "array", "items": {"type": "string"},
                      "description": "Why the file is not yet 'final'. Generated by sync/validate."}
      }
    },
    "documents": {"type": "array", "items": {"$ref": "#/$defs/Document"}},
    "standards": {"type": "array", "items": {
      "type": "object", "required": ["name", "version"], "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "provenance": {"$ref": "#/$defs/Provenance"}}}},
    "protocol": {
      "type": "object", "additionalProperties": false,
      "properties": {"objectives": {"type": "string"}, "design": {"type": "string"}, "plannedSubjects": {"type": "string"},
                     "provenance": {"$ref": "#/$defs/Provenance"}}
    },
    "estimands": {"type": "array", "items": {"$ref": "#/$defs/Estimand"}},
    "analysisConsiderations": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "coreVariables": {"type": "array", "items": {"$ref": "#/$defs/Ref"}},
        "qa": {"type": "array", "items": {
          "type": "object", "required": ["id", "section", "question", "answer"], "additionalProperties": false,
          "properties": {"id": {"$ref": "#/$defs/Id"}, "section": {"type": "string"}, "question": {"type": "string"},
                         "answer": {"type": "string"}, "about": {"type": "array", "items": {"$ref": "#/$defs/Ref"}},
                         "provenance": {"$ref": "#/$defs/Provenance"}}}}
      }
    },
    "metadata": {
      "type": "object",
      "description": "Where variable/parameter metadata come from. 'variables' and 'parameters' below are a generated snapshot of this source, stamped with its hash so staleness is detectable.",
      "additionalProperties": false,
      "properties": {"source": {"$ref": "#/$defs/Ref"}, "kind": {"enum": ["define-xml", "spec-xlsx", "none"]},
                     "sha256": {"type": ["string", "null"]}, "snapshotTakenAt": {"type": "string"}}
    },
    "datasets": {"type": "array", "items": {"$ref": "#/$defs/Dataset"}},
    "parameters": {"type": "array", "items": {"$ref": "#/$defs/Parameter"}},
    "variables": {"type": "array", "items": {"$ref": "#/$defs/Variable"}},
    "programs": {"type": "array", "items": {"$ref": "#/$defs/Program"}},
    "environment": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "r": {"type": "string"},
        "platform": {"type": "object", "additionalProperties": false,
                     "properties": {"claimed": {"type": "string"}, "observed": {"type": "array", "items": {"type": "string"}}}},
        "lockfile": {"type": ["object", "null"], "additionalProperties": false,
                     "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}}},
        "packages": {"type": "array", "items": {
          "type": "object", "required": ["name", "version"], "additionalProperties": false,
          "properties": {"name": {"type": "string"}, "version": {"type": "string"},
                         "usedBy": {"type": "array", "items": {"$ref": "#/$defs/Ref"}}}}},
        "provenance": {"$ref": "#/$defs/Provenance"}
      }
    },
    "analyses": {"type": "array", "items": {"$ref": "#/$defs/Analysis"}},
    "displays": {"type": "array", "items": {"$ref": "#/$defs/Display"}},
    "conformance": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "inputs": {"type": "array", "items": {
          "type": "object", "required": ["question", "answer"], "additionalProperties": false,
          "properties": {"question": {"type": "string"}, "answer": {"type": "string"}}}},
        "issues": {"type": "array", "items": {
          "type": "object", "required": ["ruleId", "message", "dataset", "count", "explanation"], "additionalProperties": false,
          "properties": {"ruleId": {"type": "string"}, "message": {"type": "string"}, "dataset": {"$ref": "#/$defs/Ref"},
                         "count": {"type": "integer"}, "explanation": {"type": ["string", "null"]},
                         "context": {"type": "string"}}}},
        "provenance": {"$ref": "#/$defs/Provenance"}
      }
    },
    "notes": {"type": "array", "items": {"$ref": "#/$defs/Note"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/Finding"}},
    "runInstructions": {
      "type": "object", "additionalProperties": false,
      "properties": {"order": {"type": "array", "items": {"$ref": "#/$defs/Ref"}},
                     "script": {"type": ["string", "null"]},
                     "steps": {"type": "array", "items": {"type": "string"}},
                     "provenance": {"$ref": "#/$defs/Provenance"}}
    }
  },
  "$defs": {
    "Id": {"type": "string", "pattern": "^(DOC|EST|DS|VAR|PARAM|PGM|FN|AN|DSP|CELL|NOTE|QA|FND):[A-Za-z0-9_.\\-\\[\\]=<>]+$"},
    "Ref": {"$ref": "#/$defs/Id"},
    "Stage": {"enum": ["planned", "specified", "programmed", "executed", "final"],
              "description": "planned: SAP and shells exist; specified: ADaM spec/define attached; programmed: programs exist; executed: results produced; final: no open items."},
    "Status": {"enum": ["planned", "specified", "programmed", "produced", "verified", "mismatch", "missing", "final"]},
    "Provenance": {
      "type": "object", "required": ["kind"], "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["generated", "authored"]},
        "from": {"type": "array", "items": {"type": "string"}, "description": "Sources a generated item was derived from (file path or ID, ideally with hash)."},
        "by": {"type": "string"},
        "date": {"type": "string"}
      }
    },
    "Document": {
      "type": "object", "required": ["id", "role", "status"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/Id"}, "role": {"type": "string"}, "path": {"type": ["string", "null"]},
                     "sha256": {"type": ["string", "null"]}, "status": {"enum": ["present", "missing", "external"]},
                     "note": {"type": "string"}}
    },
    "Estimand": {
      "type": "object", "required": ["id", "endpoint", "population", "variable", "summaryMeasure"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "endpoint": {"type": "object", "required": ["label", "level"], "additionalProperties": false,
                     "properties": {"label": {"type": "string"}, "level": {"enum": ["primary", "secondary", "exploratory", "safety"]}}},
        "population": {"type": "string"}, "variable": {"type": "string"},
        "treatments": {"type": "array", "items": {"type": "string"}},
        "intercurrentEvents": {"type": "array", "items": {
          "type": "object", "required": ["event", "strategy"], "additionalProperties": false,
          "properties": {"event": {"type": "string"}, "strategy": {"type": "string"},
                         "implementedBy": {"type": "array", "items": {"$ref": "#/$defs/Ref"}}}}},
        "summaryMeasure": {"type": "string"},
        "prespecification": {"type": "object", "additionalProperties": false,
                             "properties": {"status": {"enum": ["claimed", "verified", "not-prespecified"]},
                                            "evidence": {"type": ["string", "null"]}}}
      }
    },
    "Dataset": {
      "type": "object", "required": ["id", "name", "role", "status"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/Id"}, "name": {"type": "string"}, "role": {"enum": ["analysis", "tabulation"]},
        "label": {"type": ["string", "null"]}, "class": {"type": ["string", "null"]}, "structure": {"type": ["string", "null"]},
        "purposes": {"type": "array", "items": {"enum": ["efficacy", "safety", "baseline", "primary-objective"]}},
        "description": {"type": "string"},
        "file": {"type": ["object", "null"], "additionalProperties": false,
                 "properties": {"path": {"type": "string"}, "format": {"type": "string"}, "sha256": {"type": "string"},
                                "records": {"type": "integer"}, "createdAt": {"type": ["string", "null"]},
                                "sourceSystem": {"type": ["string", "null"]}}},
        "metadataRef": {"type": ["string", "null"]},
        "dependsOn": {"type": "array", "items": {"$ref": "#/$defs/Ref"}},
        "producedBy": {"oneOf": [{"$ref": "#/$defs/Ref"}, {"type": "null"}]},
        "status": {"$ref": "#/$defs/Status"},
        "provenance": {"$ref": "#/$defs/Provenance"}
      }
    },
    "Parameter": {
      "type": "object", "required": ["id", "dataset", "paramcd"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/Id"}, "dataset": {"$ref": "#/$defs/Ref"}, "paramcd": {"type": "string"},
        "param": {"type": ["string", "null"]},
        "derivation": {"type": ["object", "null"], "additionalProperties": false,
                       "properties": {"text": {"type": "string"}, "methodOID": {"type": ["string", "null"]},
                                      "whereClause": {"type": ["string", "null"]}}},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/Ref"}},
        "status": {"$ref": "#/$defs/Status"},
        "provenance": {"$ref": "#/$defs/Provenance"}
      }
    },
    "CodeAnchor": {
      "type": "object", "required": ["program", "line", "excerpt"], "additionalProperties": false,
      "properties": {"program": {"$ref": "#/$defs/Ref"}, "line": {"type": "integer"}, "excerpt": {"type": "string"},
                     "role": {"enum": ["derives", "selects", "uses"]}}
    },
    "Variable": {
      "type": "object", "required": ["id", "dataset", "name"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/Id"}, "dataset": {"$ref": "#/$defs/Ref"}, "name": {"type": "string"},
        "label": {"type": ["string", "null"]}, "origin": {"type": ["string", "null"]},
        "derivation": {"type": ["object", "null"], "additionalProperties": false,
                       "properties": {"text": {"type": ["string", "null"]}, "methodOID": {"type": ["string", "null"]}}},
        "predecessors": {"type": "array", "items": {"$ref": "#/$defs/Ref"}},
        "codeAnchors": {"type": "array", "items": {"$ref": "#/$defs/CodeAnchor"}},
        "inData": {"type": "boolean"}, "inMetadata": {"type": "boolean"},
        "status": {"$ref": "#/$defs/Status"},
        "provenance": {"$ref": "#/$defs/Provenance"}
      }
    },
    "Program": {
      "type": "object", "required": ["id", "path", "kind"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/Id"}, "path": {"type": "string"}, "kind": {"enum": ["adam", "tlf", "helper", "other"]},
        "sha256": {"type": ["string", "null"]},
        "reads": {"type": "array", "items": {"$ref": "#/$defs/Ref"}},
        "writes": {"type": "array", "items": {"type": "string"}},
        "calls": {"type": "array", "items": {"$ref": "#/$defs/Ref"}},
        "run": {"type": "object", "additionalProperties": false,
                "properties": {"receipt": {"type": ["string", "null"]},
                               "mode": {"enum": ["scripted", "interactive", "unknown"]},
                               "evidence": {"type": "string"}}},
        "status": {"$ref": "#/$defs/Status"},
        "provenance": {"$ref": "#/$defs/Provenance"}
      }
    },
    "Analysis": {
      "type": "object", "required": ["id", "dataset", "method"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/Id"}, "estimand": {"oneOf": [{"$ref": "#/$defs/Ref"}, {"type": "null"}]},
        "purpose": {"type": "string"}, "dataset": {"$ref": "#/$defs/Ref"},
        "analysisSet": {"type": "object", "description": "Population filter, e.g. {\"ITTFL\": \"Y\"}. Keys may come from ADSL."},
        "dataSubset": {"type": "object", "description": "Record filter: value, {\"in\": [...]}, or {\"notnull\": true}."},
        "groupBy": {"type": ["string", "null"]},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/Ref"}},
        "method": {"type": "object", "required": ["description"], "additionalProperties": false,
                   "properties": {"description": {"type": "string"}, "model": {"type": "object"},
                                  "implementation": {"type": ["string", "null"]}}},
        "variables": {"type": "array", "items": {"$ref": "#/$defs/Ref"}},
        "program": {"oneOf": [{"$ref": "#/$defs/Ref"}, {"type": "null"}]},
        "status": {"$ref": "#/$defs/Status"}
      }
    },
    "Cell": {
      "type": "object", "required": ["id", "analysis", "compute", "format"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/Id"}, "column": {"type": "string"}, "analysis": {"$ref": "#/$defs/Ref"},
        "compute": {"type": "object", "required": ["op"],
                    "description": "What produces the number: op (n, mean_sd, median, min_max, median_range, count, bign, ancova_*, lsmean_ci, diff_ci, diff_p, rmse), variable, where, group, contrast, value."},
        "format": {"type": "string", "description": "Shell pattern, e.g. 'xx.x (xx.xx)'."},
        "result": {"type": "object", "additionalProperties": false,
                   "properties": {"value": {"type": ["string", "null"]}, "status": {"$ref": "#/$defs/Status"},
                                  "source": {"type": ["string", "null"]}, "recomputed": {"type": ["string", "null"]}}}
      }
    },
    "Row": {
      "type": "object", "required": ["id", "label", "cells"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "label": {"type": "string"},
                     "text": {"type": "string", "description": "Regex for the row label in the rendered output (used to pick up actual values)."},
                     "anchor": {"type": "string", "description": "Regex for the line after which the row is searched."},
                     "cells": {"type": "array", "items": {"$ref": "#/$defs/Cell"}}}
    },
    "Display": {
      "type": "object", "required": ["id", "displayId", "type", "title"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/Id"}, "displayId": {"type": "string"}, "type": {"enum": ["table", "figure", "listing"]},
        "title": {"type": "string"}, "subtitle": {"type": "string"}, "population": {"type": "string"},
        "analyses": {"type": "array", "items": {"$ref": "#/$defs/Ref"}},
        "program": {"oneOf": [{"$ref": "#/$defs/Ref"}, {"type": "null"}]},
        "outputFile": {"type": ["string", "null"]},
        "renderedIn": {"type": ["object", "null"], "additionalProperties": false,
                       "properties": {"doc": {"$ref": "#/$defs/Ref"}, "page": {"type": "integer"}}},
        "columns": {"type": "array", "items": {"type": "object", "required": ["id", "label"], "additionalProperties": false,
                                               "properties": {"id": {"type": "string"}, "label": {"type": "string"}}}},
        "sections": {"type": "array", "items": {
          "type": "object", "required": ["id", "label", "rows"], "additionalProperties": false,
          "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "anchor": {"type": "string"},
                         "columns": {"type": "array", "items": {"type": "object", "required": ["id", "label"], "additionalProperties": false,
                                                                "properties": {"id": {"type": "string"}, "label": {"type": "string"}}}},
                         "rows": {"type": "array", "items": {"$ref": "#/$defs/Row"}}}}},
        "footnotes": {"type": "array", "items": {"type": "string"}},
        "status": {"$ref": "#/$defs/Status"}
      }
    },
    "Note": {
      "type": "object", "required": ["id", "about", "text", "status"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/Id"}, "about": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Ref"}},
                     "section": {"type": "string"}, "title": {"type": "string"}, "text": {"type": "string"},
                     "status": {"enum": ["draft", "final"]}, "provenance": {"$ref": "#/$defs/Provenance"}}
    },
    "Finding": {
      "type": "object", "required": ["id", "severity", "about", "text"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/Id"}, "severity": {"enum": ["error", "warning", "info"]},
                     "about": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Ref"}},
                     "text": {"type": "string"}, "check": {"type": "string"},
                     "resolution": {"type": ["string", "null"]}}
    }
  }
}
